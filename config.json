    },
    "colors": {
      "primary": "#0f172a",
      "secondary": "#334155",
      "accent": "#2563eb"
    }
  },
  "voice": {
    "tts_language": "en-US",
    "tts_rate": 0.9,
    "tts_pitch": 1.0,
    "tts_volume": 0.8,
    "tts_voice_preference": "en-US-Female",
    "stt_language": "en-US"
