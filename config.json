{
  "server": {
    "llm_port": 8080,
    "web_port": 3000,
    "host": "localhost"
  },
  "model": {
    "default_path": null,
    "context_size": 2048,
    "max_tokens": 512,
    "temperature": 0.7,
    "top_p": 0.9
  },
  "ui": {
    "avatar_animation_fps": 12,
